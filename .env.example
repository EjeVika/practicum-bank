# ============================================
# База данных для accounts-service
# ============================================
ACCOUNTS_DB_HOST=localhost
ACCOUNTS_DB_PORT=15432
ACCOUNTS_DB_NAME=accounts_db
ACCOUNTS_DB_USER=accounts
ACCOUNTS_DB_PASSWORD=accounts

# ============================================
# Keycloak
# ============================================
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=bank-realm

# Client Secrets
UI_CLIENT_SECRET=ui-client-secret
ACCOUNTS_SERVICE_CLIENT_SECRET=**********
CASH_SERVICE_CLIENT_SECRET=**********
TRANSFER_SERVICE_CLIENT_SECRET=**********

# ============================================
# Zookeeper (Service Discovery)
# ============================================
ZOOKEEPER_HOST=localhost
ZOOKEEPER_PORT=2181

# ============================================
# Порты сервисов
# ============================================
BANK_UI_PORT=8081
BANK_GATEWAY_PORT=8082
ACCOUNTS_SERVICE_PORT=8084
CASH_SERVICE_PORT=8085
TRANSFER_SERVICE_PORT=8086
NOTIFICATIONS_SERVICE_PORT=8087
CONFIG_SERVER_PORT=8888

# ============================================
# Gateway
# ============================================
BANK_GATEWAY_HOST=localhost
